# Copy this file to .env for local development. Replace placeholder values
# before deploying to any shared or public environment.
APP_ENV=development
DEVELOPMENT_USER_EMAIL=developer@example.com
DEVELOPMENT_USER_FULL_NAME=Development Recruiter
CORS_ORIGINS=http://localhost:3000
CV_STORAGE_PATH=/app/storage/resumes
MAX_CV_SIZE_MB=5
MAX_JOB_DOCUMENT_SIZE_MB=5

# Optional. Non-AI backend features start normally when these are empty.
# Use an OpenAI-compatible provider and never commit real credentials.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0

POSTGRES_DB=recruitment_agent
POSTGRES_USER=recruitment_agent
POSTGRES_PASSWORD=replace-with-a-strong-local-password

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
